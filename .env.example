# Environment
# The app origin is detected from each request; set NEXT_PUBLIC_BASE_URL only
# to force a different public URL (for example behind a proxy).
DEVELOPMENT=true
NEXT_PUBLIC_BASE_URL=

# Database
MONGODB_URI=mongodb://localhost:27017/booking-form
MONGODB_DB=booking-form

# Authentication
NEXTAUTH_SECRET=changeme

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Visitor country (booking allow-list lives in Settings > Map Configuration)
# In production the country comes from the hosting geo header:
# x-vercel-ip-country (Vercel) or cf-ipcountry (Cloudflare).
# GEO_IP_FALLBACK=off disables the ip-api development fallback (HTTP-only, and
# not licensed for commercial use).
# GEO_COUNTRY_OVERRIDE=PK forces a country outside production so the
# allow-list block can be exercised on localhost.
GEO_IP_FALLBACK=
GEO_COUNTRY_OVERRIDE=

# Stripe
STRIPE_API_VERSION=2025-09-30.clover

# Email
# Fallback admin inbox when no admin user exists in DB (also synced at build time)
ADMIN_EMAIL=
SMTP_SERVERNAME=

# Site configuration (name, logo, phone, support email) lives in
# Settings → Appearance and is stored in the database.
 
# Cron
CRON_SECRET=
